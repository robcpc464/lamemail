def addr(account, key):
    name, address, _, _ = PEOPLE[key]
    return {"name": name, "address": address or ACCOUNTS[account]["address"]}


def quoted(text):
    return "\n".join("> " + line if line else ">" for line in text.rstrip("\n").split("\n")) + "\n"


def attribution(lang, previous):
    sender = previous["from"][0]
    name = sender["name"] or sender["address"]
    date, time = previous["received"][:10], previous["received"][11:16]
    if lang == "en":
        return f"On {date} at {time}, {name} <{sender['address']}> wrote:\n"
    return f"Am {date} um {time} schrieb {name}:\n"


def when_of(step):
    if step["ago"] is not None:
        return NOW - datetime.timedelta(minutes=step["ago"])
    hour, minute = (int(part) for part in step["clock"].split(":"))
    day = NOW - datetime.timedelta(days=step["days"])
    when = day.replace(hour=hour, minute=minute, tzinfo=None).astimezone()
    return min(when, NOW - datetime.timedelta(minutes=2))


def build(account, steps, uid):
    written = []
    originals = []
    for index, step in enumerate(steps):
        when = when_of(step)
        own = step["sender"] in ("me", "post")
        folder = step["folder"] or (marked(account, "sent") if own else "inbox")
        lang, signature = PEOPLE[step["sender"]][2], PEOPLE[step["sender"]][3]
        text = step["text"]
        previous = originals[step["reply"]] if step["reply"] is not None else None
        if signature:
            text += "\n" + signature
        if previous is not None:
            text += "\n" + attribution(lang, previous) + quoted(previous["body"])
        uid += 1
        msg = {
            "message_id": f"{uid}@dev.lamemail",
            "references": (previous["references"] + [previous["message_id"]]) if previous else [],
            "from": [addr(account, step["sender"])],
            "received": when.isoformat(),
            "body": text,
        }
        flags = "".join(
            letter
            for letter, on in (
                ("S", step["seen"]),
                ("A", any(other["reply"] == index for other in steps)),
                ("F", step["flagged"]),
                ("D", folder == marked(account, "drafts")),
            )
            if on
        )
        eml = compose(account, step, when, msg, previous)
        written.append((folder, when, uid, flags, eml))
        originals.append(msg)
        for extra in step["also"]:
            uid += 1
            written.append((extra, when, uid, flags, eml))
    return written, uid


def compose(account, step, when, msg, previous):
    out = email.message.EmailMessage()
    out["From"] = mailbox(msg["from"][0])
    out["To"] = ", ".join(mailbox(addr(account, key)) for key in step["to"])
    if step["cc"]:
        out["Cc"] = ", ".join(mailbox(addr(account, key)) for key in step["cc"])
    out["Subject"] = step["subject"]
    out["Date"] = email.utils.format_datetime(when)
    out["Message-ID"] = f"<{msg['message_id']}>"
    if previous is not None:
        out["In-Reply-To"] = f"<{previous['message_id']}>"
        out["References"] = " ".join(f"<{ref}>" for ref in msg["references"])
    if isinstance(step["html"], str):
        out.set_content(step["html"], subtype="html")
    elif step["html"]:
        out.set_content(f"<html><body>{as_html(msg['body'])}</body></html>", subtype="html")
    else:
        out.set_content(msg["body"])
    for name, kind, content in step["att"]:
        maintype, subtype = kind.split("/", 1)
        data = content if isinstance(content, bytes) else bytes(content)
        out.add_attachment(data, maintype=maintype, subtype=subtype, filename=name)
    return out.as_bytes(policy=email.policy.SMTP)


def as_html(text):
    blocks, lines = [], text.rstrip("\n").split("\n")
    while lines:
        quoted = lines[0].startswith(">")
        block = []
        while lines and lines[0].startswith(">") == quoted:
            block.append(lines.pop(0))
        if quoted:
            inner = "\n".join(line[1:].removeprefix(" ") for line in block)
            blocks.append(f'<blockquote type="cite">{as_html(inner)}</blockquote>')
        else:
            blocks.append("".join(f"<div>{html.escape(line) or '<br>'}</div>" for line in block))
    return "".join(blocks)


def marked(account, special):
    return next(folder for folder, mark in ACCOUNTS[account]["marks"].items() if mark == special)


def mailbox(address):
    return email.utils.formataddr((address["name"] or "", address["address"]))


def write(account, folder, when, uid, flags, eml):
    name = f"{uid},{flags}" if flags else str(uid)
    path = f"{SERVER}/{account}/{ACCOUNTS[account]['folders'][folder]}/{name}.eml"
    with open(path, "wb") as f:
        f.write(eml)
    stamp = when.timestamp()
    os.utime(path, (stamp, stamp))


def main():
    shutil.rmtree(SERVER, ignore_errors=True)
    total = 0
    uid = 100
    for account, conversations in (("private", PRIVATE), ("business", BUSINESS)):
        for folder, imap_name in ACCOUNTS[account]["folders"].items():
            os.makedirs(f"{SERVER}/{account}/{imap_name}")
            with open(f"{SERVER}/{account}/{imap_name}/.uidvalidity", "w") as f:
                f.write(f"{UIDVALIDITY}\n")
            if folder in ACCOUNTS[account]["marks"]:
                with open(f"{SERVER}/{account}/{imap_name}/.special", "w") as f:
                    f.write(ACCOUNTS[account]["marks"][folder] + "\n")
        for steps in conversations:
            written, uid = build(account, steps, uid)
            for entry in written:
                write(account, *entry)
                total += 1
    print(f"{total} messages on the development server {SERVER}")


main()
